{
  "name": "sloption",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sloption": "./src/backend/adapters/cli/main.ts"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx scripts/dev.ts",
    "build": "vite build",
    "server": "tsx src/backend/server/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "cli": "tsx src/backend/adapters/cli/main.ts",
    "import:notion": "tsx scripts/import-notion.ts",
    "install:cli": "mkdir -p \"${SLOPTION_BIN:-$HOME/.local/bin}\" && ln -sf \"$PWD/src/backend/adapters/cli/main.ts\" \"${SLOPTION_BIN:-$HOME/.local/bin}/sloption\" && echo \"sloption -> $PWD/src/backend/adapters/cli/main.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.32",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.0",
    "csv-parse": "^7.0.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
